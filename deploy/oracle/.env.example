# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o git.
# Os campos marcados com  <<< COLE AQUI  são segredos ou dados da sua conta.

# ---------- Domínio e HTTPS (Caddy) ----------
# O endereço público da API, sem https:// e sem barra. O domínio do Verso é
# verso.net.br: crie no Registro.br um registro A "api" -> IP da VM (passo 6 do
# guia). Para testar antes do DNS resolver: api.<IP-COM-TRACOS>.sslip.io
DOMINIO=api.verso.net.br
# E-mail para o Let's Encrypt avisar se o certificado tiver problema.
# <<< COLE AQUI
ACME_EMAIL=voce@exemplo.com

# ---------- Banco (Postgres na própria VM, serviço db) ----------
# A senha do usuário verso do Postgres. Só letras e números (entra na URL do banco).
# Gere com:  openssl rand -hex 24
# <<< COLE AQUI
POSTGRES_PASSWORD=
# A api e o seed montam a DATABASE_URL sozinhos (postgresql://verso:...@db:5432/verso).
# Só defina DATABASE_URL para usar o Supabase (compose.supabase.yaml, docs/deploy-oracle.md).

# Pool de conexões POR WORKER (lido pelo app/db.py). Conta: réplicas x WEB_CONCURRENCY x
# (POOL + OVERFLOW + 1) precisa caber no max_connections do db (60, no compose.yaml),
# com folga (8) para o backup, o seed e a manutenção; o + 1 é o LISTEN das mensagens,
# um por worker. 2 réplicas x 1 x (4 + 2 + 1) = 14; 4 réplicas, 28: com a folga, 22 e 36
# (docs/deploy-oracle.md, "Workers e pool").
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Memória do Postgres, para a VM de 4 OCPU e 24 GB. Na VM de 2 OCPU e 12 GB, TROQUE
# pelos valores de 12 GB: 1GB, 6GB, 8MB e 256MB, nesta ordem (docs/deploy-oracle.md,
# passo 7 e "Disco e memória da VM").
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB

# ---------- Backup (serviço backup) ----------
# Todo dia em BACKUP_HORA (fuso TZ): pg_dump no volume backups, com data e hora (UTC)
# e o hostname da VM no nome. Retenção: BACKUP_DIARIOS datas e BACKUP_SEMANAIS semanas
# (os de domingo).
TZ=America/Sao_Paulo
BACKUP_HORA=03:30
BACKUP_DIARIOS=7
BACKUP_SEMANAIS=4
# Cópia no Object Storage da Oracle (API compatível com S3). Vazios = só o backup local.
# Passo a passo: docs/deploy-oracle.md, passo 11.
# O nome do bucket (Storage -> Object Storage & Archive Storage -> Buckets, no root).  <<< COLE AQUI
OCI_BUCKET=verso-backups
# https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
# (o Namespace está em Bucket Information)  <<< COLE AQUI
OCI_S3_ENDPOINT=
# A região do bucket (Brazil East, Sao Paulo).
OCI_REGIAO=sa-saopaulo-1
# Customer Secret Key (Perfil -> My profile -> Customer secret keys): o Access Key
# da lista e o Secret Key, que só aparece na geração.  <<< COLE AQUI
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# ---------- Seed ----------
# true: no PRIMEIRO "up", com o banco sem usuários, o serviço seed popula o banco.
# Nos seguintes ele vê usuários e não faz nada. A api sempre roda com false.
SEED_ON_BOOT=true

# ---------- CORS ----------
# Os endereços do front, com https e sem barra, separados por vírgula:
# o domínio próprio, o www e o da Vercel.
CORS_ORIGINS=https://verso.net.br,https://www.verso.net.br,https://verso-blond.vercel.app

# ---------- Tradução (opcional) ----------
# Chave SÓ da demo, num workspace com limite de gasto baixo. Vazia: a tradução dá 503.
# <<< COLE AQUI (sk-ant-...)
ANTHROPIC_API_KEY=

# ---------- Réplicas da API ----------
# Quantas réplicas sobem, pelo tamanho da VM (medido com 100 usuários; docs/deploy-oracle.md,
# "Workers e pool"):
#   2 OCPU, 12 GB: 2 réplicas, o padrão abaixo (92 req/s sem pausa; 3 e 4 réplicas
#                  disputam a CPU com o Postgres e rendem menos: 82 a 90 req/s).
#   4 OCPU, 24 GB: 4 réplicas (153 req/s sem pausa, contra 104 com 2). Troque as duas
#                  linhas por estas e rode ./atualizar.sh --sem-pull:
#     COMPOSE_PROFILES=4-ocpu
#     REPLICAS_DA_API=api_1:8000 api_2:8000 api_3:8000 api_4:8000
# As duas andam juntas: o atualizar.sh confere e para se não baterem.
COMPOSE_PROFILES=
REPLICAS_DA_API=api_1:8000 api_2:8000

# ---------- Workers do uvicorn (POR RÉPLICA) ----------
# 1 worker por réplica: escala-se pelo número de réplicas (acima). Com 1, a réplica que
# para fecha a porta na hora e o Caddy tenta outra (0 erro ao derrubar uma no meio da
# carga). Com 2 ou mais, o processo pai do uvicorn mantém a porta aberta enquanto os
# workers desligam, e as requisições que chegam nesse meio-tempo voltam com 502
# (docs/deploy-oracle.md, "Workers e pool"). O backend não guarda estado em memória
# (índice de tags e limite da tradução estão no banco), então as réplicas veem os
# mesmos dados.
WEB_CONCURRENCY=1
WEB_CONCURRENCY_MAX=1

# ---------- Monitoramento (opcional) ----------
# DSN do projeto no sentry.io. Vazio = Sentry desligado.
# <<< COLE AQUI (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=producao
SENTRY_TRACES_SAMPLE_RATE=0

# NUNCA defina DEBUG aqui (nem DEBUG=false): com DEBUG=true o header X-User-Id
# entra como qualquer usuário, sem senha.
