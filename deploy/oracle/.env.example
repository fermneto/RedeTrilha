# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o git.
# Os campos marcados com  <<< COLE AQUI  são segredos ou dados da sua conta.

# ---------- Domínio e HTTPS (Caddy) ----------
# O endereço público da API, sem https:// e sem barra. Opções gratuitas:
#   api.<IP-COM-TRACOS>.sslip.io   ex.: api.129-146-10-20.sslip.io
#   <nome>.duckdns.org             (crie em duckdns.org e aponte para o IP)
# <<< COLE AQUI (troque pelo seu)
DOMINIO=api.0-0-0-0.sslip.io
# E-mail para o Let's Encrypt avisar se o certificado tiver problema.
# <<< COLE AQUI
ACME_EMAIL=voce@exemplo.com

# ---------- Banco (Postgres na própria VM, serviço db) ----------
# A senha do usuário verso do Postgres. Só letras e números (entra na URL do banco).
# Gere com:  openssl rand -hex 24
# <<< COLE AQUI
POSTGRES_PASSWORD=
# A api e o seed montam a DATABASE_URL sozinhos (postgresql://verso:...@db:5432/verso).
# Só defina DATABASE_URL para usar o Supabase (compose.supabase.yaml, docs/deploy-oracle.md).

# Pool de conexões POR WORKER (lido pelo app/db.py). Conta: WEB_CONCURRENCY x (POOL + OVERFLOW)
# precisa caber no max_connections do db (60, no compose.yaml), com folga para o backup
# e a manutenção. O padrão: 2 x (4 + 2) = 12 (o menor p95 medido, ver os workers abaixo).
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Memória do Postgres, para a VM de 4 OCPU e 24 GB. VM menor: a tabela em
# docs/deploy-oracle.md ("Disco e memória da VM"); com 12 GB: 1GB, 6GB, 8MB, 256MB.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB

# ---------- Backup (serviço backup) ----------
# Todo dia em BACKUP_HORA (fuso TZ): pg_dump no volume backups, com data e hora (UTC)
# e o hostname da VM no nome. Retenção: BACKUP_DIARIOS datas e BACKUP_SEMANAIS semanas
# (os de domingo).
TZ=America/Sao_Paulo
BACKUP_HORA=03:30
BACKUP_DIARIOS=7
BACKUP_SEMANAIS=4
# Cópia no Object Storage da Oracle (API compatível com S3). Vazios = só o backup local.
# Passo a passo: docs/deploy-oracle.md, passo 11.
# O nome do bucket (Storage -> Object Storage & Archive Storage -> Buckets, no root).  <<< COLE AQUI
OCI_BUCKET=verso-backups
# https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
# (o Namespace está em Bucket Information)  <<< COLE AQUI
OCI_S3_ENDPOINT=
# A região do bucket (Brazil East, Sao Paulo).
OCI_REGIAO=sa-saopaulo-1
# Customer Secret Key (Perfil -> My profile -> Customer secret keys): o Access Key
# da lista e o Secret Key, que só aparece na geração.  <<< COLE AQUI
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# ---------- Seed ----------
# true: no PRIMEIRO "up", com o banco sem usuários, o serviço seed popula o banco.
# Nos seguintes ele vê usuários e não faz nada. A api sempre roda com false.
SEED_ON_BOOT=true

# ---------- CORS ----------
# A URL de produção da Vercel, com https e sem barra. Várias: separe por vírgula.
# <<< COLE AQUI (o domínio que a Vercel der)
CORS_ORIGINS=https://verso.vercel.app

# ---------- Tradução (opcional) ----------
# Chave SÓ da demo, num workspace com limite de gasto baixo. Vazia: a tradução dá 503.
# <<< COLE AQUI (sk-ant-...)
ANTHROPIC_API_KEY=

# ---------- Workers do uvicorn ----------
# 2 workers com o pool 4 + 2 acima: o menor p95 medido na VM de 4 OCPU, com o Postgres
# ao lado (100 usuários: p95 47-48 ms com pausa de 3 s; 146-156 req/s e p95 0,8-0,92 s
# sem pausa; 0 erro). 4 workers empatam com pausa e oscilam sem pausa (0,84-2,2 s): a
# CPU é a mesma do Postgres (docs/deploy-oracle.md, "Workers e pool").
# O backend não guarda estado em memória (índice de tags e limite da tradução estão
# no banco), então os workers veem os mesmos dados. Mudou o número? Refaça a conta
# do pool acima. Vazio = 2 x núcleos + 1, limitado a WEB_CONCURRENCY_MAX.
WEB_CONCURRENCY=2
WEB_CONCURRENCY_MAX=4

# ---------- Monitoramento (opcional) ----------
# DSN do projeto no sentry.io. Vazio = Sentry desligado.
# <<< COLE AQUI (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=producao
SENTRY_TRACES_SAMPLE_RATE=0

# NUNCA defina DEBUG aqui (nem DEBUG=false): com DEBUG=true o header X-User-Id
# entra como qualquer usuário, sem senha.
