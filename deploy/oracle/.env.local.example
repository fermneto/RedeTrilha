# Só para o teste local com compose.local.yaml (Postgres descartável, sem segredos).
DOMINIO=localhost
ACME_EMAIL=teste@exemplo.com
HTTP_PORT=8080
HTTPS_PORT=8443
DATABASE_URL=postgresql://postgres:teste-local@db:5432/postgres
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
SEED_ON_BOOT=true
CORS_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=
WEB_CONCURRENCY=
WEB_CONCURRENCY_MAX=4
SENTRY_DSN=
