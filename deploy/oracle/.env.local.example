SENTRY_DSN=
OCI_BUCKET=verso-backups
OCI_S3_ENDPOINT=http://s3-falso:9000
OCI_REGIAO=us-east-1
OCI_ACCESS_KEY=teste-acesso
OCI_SECRET_KEY=teste-segredo
COMPOSE_PROFILES=
REPLICAS_DA_API=api_1:8000 api_2:8000
