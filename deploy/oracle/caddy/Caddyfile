# Proxy reverso do Verso: HTTPS automático (Let's Encrypt, com ZeroSSL de reserva).
# DOMINIO vem do .env: o seu domínio, um DuckDNS (verso.duckdns.org) ou um
# sslip.io com o IP público (api.129-146-10-20.sslip.io). Com "localhost", o
# Caddy usa uma CA interna (teste local, curl -k).
#
# Balanceador: o Caddy divide as requisições entre as réplicas da API
# (api_1 a api_4, no compose.yaml). Uma réplica que cai ou não responde ao
# /saude sai da roda em segundos, e a requisição que falhou ao conectar tenta a
# outra. É o que deixa o atualizar.sh reiniciar uma réplica de cada vez sem queda.
{
	email {$ACME_EMAIL}
	servers {
		# Tempo máximo para o visitante mandar a requisição. Sem limite de escrita
		# (o "write"): ele vale para a resposta inteira, e o stream das mensagens
		# (SSE) fica aberto por minutos; com "write 60s", o Caddy o derrubava aos
		# 60 s. As respostas comuns da API são pequenas e saem em milissegundos.
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

# As réplicas e o que fazer quando uma falha; entra em cada reverse_proxy.
(replicas) {
	to api_1:8000 api_2:8000 api_3:8000 api_4:8000

	# Ativo: GET /saude em cada réplica a cada 2 s. Duas falhas seguidas (ou 2 s sem
	# resposta) tiram a réplica da roda; uma resposta boa a devolve.
	health_uri /saude
	health_interval 2s
	health_timeout 2s
	health_fails 2
	health_passes 1

	# Passivo: uma requisição que falhou (conexão recusada, réplica parando) tira
	# a réplica por 10 s, sem esperar o próximo /saude. Um 500 da API não conta: é
	# erro da rota, não da réplica.
	fail_duration 10s
	max_fails 1

	# Tentar outra réplica: até 2 vezes, por até 5 s. Se a CONEXÃO falhou, a
	# requisição não chegou à API e o Caddy tenta de novo qualquer método (é
	# seguro). Se ela chegou e a resposta falhou no meio, só GET e HEAD são
	# repetidos: um POST (publicar, curtir, mandar mensagem) nunca vai duas vezes.
	lb_retries 2
	lb_try_duration 5s
	lb_try_interval 250ms
	lb_retry_match {
		method GET HEAD
	}
	# O transport (dial_timeout de 2 s) fica em cada reverse_proxy: um segundo
	# bloco transport substitui o primeiro, não soma.
}

{$DOMINIO} {
	# Poemas não têm limite de caracteres, mas 2 MB por requisição é folga enorme.
	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# O stream das mensagens (Server-Sent Events) fica aberto por minutos: sem
	# compressão (o encode seguraria os eventos em buffer) e com flush a cada
	# evento. A API manda um comentário a cada 20 s, então a conexão nunca fica
	# parada o bastante para o idle derrubar. Balanceado como o resto: se a
	# réplica do stream cair, o navegador reconecta e o Caddy o manda a outra.
	# least_conn: cada stream novo vai para a réplica com menos conexões abertas,
	# e os streams se espalham entre elas.
	@stream path /mensagens/stream
	handle @stream {
		reverse_proxy {
			import replicas
			lb_policy least_conn
			flush_interval -1
			transport http {
				dial_timeout 2s
			}
		}
	}

	handle {
		# Comprime JSON grande (feed, acervo). Se a API também comprimir
		# (GZipMiddleware), o Caddy vê o Content-Encoding e não comprime de novo.
		encode zstd gzip
		# Requisições curtas: round_robin, uma réplica de cada vez. O least_conn
		# contaria os streams abertos como carga e, depois de um deploy (os streams
		# todos nas réplicas que ficaram de pé), mandaria tudo para a última reiniciada.
		reverse_proxy {
			import replicas
			lb_policy round_robin
			transport http {
				dial_timeout 2s
				response_header_timeout 60s
			}
		}
	}

	# Cada linha do log diz qual réplica respondeu (docker compose logs caddy).
	log_append upstream {rp.upstream.hostport}
	log {
		output stdout
		format json
	}
}
